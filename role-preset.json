{
  "version": 2,
  "agents": [
    {
      "id": "cc",
      "name": "Claude Code",
      "adapter": "cli",
      "command": "claude",
      "args": ["-p"],
      "promptMode": "stdin",
      "modelArgs": ["--model", "{model}"],
      "autoArgs": ["--permission-mode", "acceptEdits", "--allowedTools", "Bash,Read,Write,Edit,Glob,Grep,WebSearch,WebFetch"],
      "models": ["opus", "sonnet", "haiku"],
      "timeoutMs": 900000,
      "traits": ["规划", "架构", "实现", "读代码库"],
      "enabled": true
    },
    {
      "id": "codex",
      "name": "Codex",
      "adapter": "cli",
      "command": "codex",
      "args": ["exec", "--skip-git-repo-check"],
      "promptMode": "stdin",
      "modelArgs": ["--model", "{model}"],
      "autoArgs": ["--full-auto", "-c", "sandbox_workspace_write.network_access=true"],
      "models": ["gpt-5-codex", "gpt-5", "o3"],
      "timeoutMs": 900000,
      "traits": ["审查", "测试", "异构视角"],
      "enabled": true
    },
    {
      "id": "workbuddy",
      "name": "WorkBuddy",
      "adapter": "cli",
      "command": "codebuddy",
      "args": ["-p"],
      "promptMode": "stdin",
      "modelArgs": ["--model", "{model}"],
      "autoArgs": [],
      "models": ["auto", "hy3", "glm-5.3", "kimi-k3-1", "deepseek-v4-pro", "deepseek-v4-flash"],
      "timeoutMs": 900000,
      "traits": ["表格", "文档", "报表", "腾讯文档"],
      "enabled": true
    },
    {
      "id": "dsh",
      "name": "DSH",
      "adapter": "self",
      "models": [],
      "traits": ["调度", "本机工具", "宿主"],
      "enabled": true
    },
    {
      "id": "qwen",
      "name": "千问办公",
      "adapter": "manual",
      "models": [],
      "traits": ["公文", "PPT", "会议纪要"],
      "enabled": true
    },
    {
      "id": "coser",
      "name": "COSER",
      "adapter": "manual",
      "models": [],
      "traits": ["待配置"],
      "enabled": false
    }
  ],
  "roles": {
    "zhongshu": { "title": "中书省", "duty": "起草方案（拟旨）", "agentId": "cc", "model": "" },
    "menxia": { "title": "门下省", "duty": "审议封驳", "agentId": "codex", "model": "" },
    "shangshu": { "title": "尚书省", "duty": "派单与汇总", "agentId": "dsh", "model": "" },
    "personnel": { "title": "吏部", "duty": "人事、账号、权限、配置", "agentId": "cc", "model": "" },
    "revenue": { "title": "户部", "duty": "数据、表格、报表、财务", "agentId": "workbuddy", "model": "" },
    "rites": { "title": "礼部", "duty": "文书、汇报、PPT、对外沟通", "agentId": "qwen", "model": "" },
    "war": { "title": "兵部", "duty": "写代码、构建、部署", "agentId": "cc", "model": "" },
    "justice": { "title": "刑部", "duty": "测试、审查、合规", "agentId": "codex", "model": "" },
    "works": { "title": "工部", "duty": "界面、设计、基础设施", "agentId": "coser", "model": "" }
  },
  "rules": {
    "separationOfPowers": true,
    "maxReviewRounds": 3,
    "maxSteps": 8,
    "autonomous": false,
    "maxFixRounds": 2,
    "fallbackAgentId": "cc"
  }
}
